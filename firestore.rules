rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function conversation(convId) {
      return get(/databases/$(database)/documents/conversations/$(convId));
    }

    function isParticipant(convId) {
      return signedIn()
        && request.auth.uid in conversation(convId).data.participants;
    }

    function validParticipantList() {
      return request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /conversations/{convId} {
      allow create: if signedIn() && validParticipantList();
      allow read, update: if signedIn()
        && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if isParticipant(convId);

        allow create: if isParticipant(convId)
          && request.auth.uid == request.resource.data.senderId;

        allow update: if isParticipant(convId)
          && (
            request.auth.uid == resource.data.senderId
            || request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'reactions', 'deletedFor'])
          );

        allow delete: if false;
      }
    }
  }
}
